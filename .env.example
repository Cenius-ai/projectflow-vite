# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored and should NEVER be committed.
# Values here are placeholders / examples ONLY.

# ─── Required ───

# Provider: Database
# Docs: Connection string for your database; format: <scheme>://<user>:<password>@<host>:<port>/<dbname>
# Database configuration. Obtain from the provider dashboard.
DATABASE_URL=file:./data/app.db

# Provider: App secret
# Docs: Generate via `openssl rand -hex 32`
# App secret configuration. Obtain from the provider dashboard.
JWT_SECRET=<your-value-here>

# ─── Optional ───

# App configuration value.
BACKEND_PID=<set in .env>

# App configuration value.
FRONTEND_PID=<set in .env>

# App configuration value.
ROOT=<set in .env>
